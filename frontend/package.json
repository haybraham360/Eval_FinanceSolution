{
  "name": "ledger-eval-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only website over the committed Ledger-Eval repository. Data comes from scripts/export_explorer_data.py.",
  "scripts": {
    "data": "python3 ../scripts/export_explorer_data.py --out public/explorer-data.json",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
